<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lpc_trabajador_tree" model="ir.ui.view">
        <field name="name">lepetitcan.trabajador.tree</field>
        <field name="model">lepetitcan.trabajador</field>
        <field name="arch" type="xml">
            <tree string="Trabajadores">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_lpc_trabajador_form" model="ir.ui.view">
        <field name="name">lepetitcan.trabajador.form</field>
        <field name="model">lepetitcan.trabajador</field>
        <field name="arch" type="xml">
            <form string="Trabajador">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                    </group>
                    <group string="Horario laboral">
                        <field name="horario_laboral" colspan="2"/>
                    </group>
                    <field name="servicio_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lpc_trabajador" model="ir.actions.act_window">
        <field name="name">Trabajadores</field>
        <field name="res_model">lepetitcan.trabajador</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_lpc_trabajador" name="Trabajadores" action="action_lpc_trabajador" parent="menu_lpc_root"/>
</odoo>